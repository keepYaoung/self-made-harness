{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-write.mjs\"", "statusMessage": "하네스 저장 권한 확인" }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-judge.mjs\"", "statusMessage": "판정자 권한 확인" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-review.mjs\"", "statusMessage": "사용자 확인 대기 여부 확인" }
        ]
      }
    ]
  }
}
